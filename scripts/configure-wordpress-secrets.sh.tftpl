#!/usr/bin/env bash
set -euo pipefail

install -d -m 755 /usr/local/libexec

cat > /usr/local/libexec/wordpress-fetch-secret.py <<'PY'
import grp
import json
import os
import sys
import tempfile
import urllib.request

try:
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({})
    )

    def get_json(url, headers):
        request = urllib.request.Request(url, headers=headers)
        with opener.open(request, timeout=30) as response:
            return json.load(response)

    token = get_json(
        "http://169.254.169.254/metadata/identity/oauth2/token"
        "?api-version=2018-02-01"
        "&resource=https%3A%2F%2Fvault.azure.net",
        {"Metadata": "true"},
    )["access_token"]

    password = get_json(
        "https://${vault_name}.vault.azure.net"
        "/secrets/wordpress-db-password?api-version=7.4",
        {"Authorization": f"Bearer {token}"},
    )["value"]

    if not password:
        raise ValueError("Empty password")

    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir="/run/wordpress",
            delete=False,
        ) as target:
            temporary_path = target.name
            os.fchmod(target.fileno(), 0o640)
            os.fchown(
                target.fileno(),
                0,
                grp.getgrnam("www-data").gr_gid,
            )
            target.write(password)

        os.replace(temporary_path, "/run/wordpress/db-password")
    finally:
        if temporary_path and os.path.exists(temporary_path):
            os.unlink(temporary_path)

    print("WordPress database password loaded.")
except Exception as error:
    print(
        f"Secret retrieval failed: {type(error).__name__}",
        file=sys.stderr,
    )
    sys.exit(1)
PY

chmod 755 /usr/local/libexec/wordpress-fetch-secret.py

cat > /etc/systemd/system/wordpress-secrets.service <<'UNIT'
[Unit]
Description=Retrieve WordPress database password from Key Vault
Wants=network-online.target
After=network-online.target
Before=apache2.service

[Service]
Type=oneshot
User=root
Group=www-data
RuntimeDirectory=wordpress
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/python3 /usr/local/libexec/wordpress-fetch-secret.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

install -d -m 755 /etc/systemd/system/apache2.service.d

cat > /etc/systemd/system/apache2.service.d/wordpress-secrets.conf <<'UNIT'
[Unit]
Requires=wordpress-secrets.service
After=wordpress-secrets.service
UNIT

systemctl daemon-reload
systemctl enable wordpress-secrets.service
systemctl restart wordpress-secrets.service
systemctl restart apache2

echo "WordPress runtime secret service configured."
